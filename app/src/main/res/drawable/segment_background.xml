<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_secondary">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape><solid android:color="@color/surface" /><corners android:radius="12dp" /></shape>
            </item>
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape><solid android:color="@color/surface" /><corners android:radius="12dp" /></shape>
    </item>
</ripple>
