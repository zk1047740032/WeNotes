<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/library_back" android:layout_width="wrap_content" android:layout_height="48dp"
            android:minWidth="64dp" android:text="@string/back" android:textAllCaps="false"
            android:background="@drawable/secondary_button_background" android:backgroundTint="@null"
            android:textColor="@color/primary_dark" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="16dp" android:text="@string/my_shelf"
            android:textSize="26sp" android:textStyle="bold" android:textColor="@color/primary_dark" />
        <Button android:id="@+id/library_refresh" android:layout_width="wrap_content" android:layout_height="48dp"
            android:minWidth="64dp" android:text="@string/sync" android:textAllCaps="false"
            android:background="@drawable/secondary_button_background" android:backgroundTint="@null"
            android:textColor="@color/primary_dark" />
    </LinearLayout>
    <TextView android:id="@+id/shelf_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:textSize="15sp" android:textColor="@color/text_secondary" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal">
        <Button android:id="@+id/shelf_tab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="@string/shelf_tab" android:textAllCaps="false" android:backgroundTint="@null"
            android:background="@drawable/button_background" android:textColor="@color/surface" />
        <Button android:id="@+id/notebooks_tab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginStart="12dp" android:text="@string/notebooks_tab" android:textAllCaps="false"
            android:backgroundTint="@null" android:background="@drawable/secondary_button_background"
            android:textColor="@color/primary_dark" />
    </LinearLayout>
    <EditText android:id="@+id/book_search" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="16dp" android:hint="@string/search_books" android:singleLine="true"
        android:inputType="text" android:imeOptions="actionDone" android:importantForAutofill="no"
        android:textSize="15sp" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" />
    <TextView android:id="@+id/library_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/library_hint" android:textSize="12sp"
        android:textColor="@color/text_secondary" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp">
        <ListView android:id="@+id/book_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@android:color/transparent" android:dividerHeight="12dp"
            android:listSelector="@drawable/secondary_button_background" android:clipToPadding="false" android:paddingBottom="12dp" />
        <TextView android:id="@+id/library_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="24dp" android:text="@string/loading_library"
            android:textSize="16sp" android:textColor="@color/text_secondary" />
    </FrameLayout>
    <TextView android:id="@+id/library_sync_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:paddingBottom="4dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
</LinearLayout>
</FrameLayout>
