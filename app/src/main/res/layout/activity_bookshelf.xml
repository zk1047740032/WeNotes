<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/search_background"
            android:paddingStart="16dp" android:paddingEnd="16dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_search" android:importantForAccessibility="no" />
            <EditText android:id="@+id/book_search" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginStart="10dp" android:background="@null"
                android:hint="@string/search_books" android:singleLine="true" android:inputType="text"
                android:imeOptions="actionDone" android:importantForAutofill="no" android:textSize="14sp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" />
        </LinearLayout>
        <TextView android:id="@+id/shelf_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="4dp" android:orientation="horizontal">
            <Button android:id="@+id/recent_tab" style="@style/ReadingTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="4" android:text="@string/recent_tab" />
            <Button android:id="@+id/notebooks_tab" style="@style/ReadingTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="5" android:text="@string/notebooks_tab" />
            <Button android:id="@+id/favorites_tab" style="@style/ReadingTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="4" android:text="@string/favorites_tab" />
        </LinearLayout>
        <LinearLayout android:id="@+id/recent_periods" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:padding="4dp"
            android:background="@drawable/segment_tray_background">
            <Button android:id="@+id/recent_week" style="@style/PeriodTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="@string/recent_week" />
            <Button android:id="@+id/recent_month" style="@style/PeriodTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="@string/recent_month" />
            <Button android:id="@+id/recent_half_year" style="@style/PeriodTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="@string/recent_half_year" />
        </LinearLayout>
        <TextView android:id="@+id/library_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/library_hint" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:lineSpacingExtra="4dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="20dp">
            <GridView android:id="@+id/book_list" android:layout_width="match_parent" android:layout_height="match_parent"
                android:numColumns="3" android:stretchMode="columnWidth" android:horizontalSpacing="16dp"
                android:verticalSpacing="24dp" android:listSelector="@drawable/text_button_background"
                android:clipToPadding="false" android:paddingTop="2dp" android:paddingBottom="20dp" android:scrollbars="none" />
            <TextView android:id="@+id/library_empty" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:padding="24dp" android:text="@string/loading_library"
                android:textSize="15sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp" />
        </FrameLayout>
        <TextView android:id="@+id/library_sync_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:paddingTop="10dp" android:paddingBottom="12dp" android:textSize="11sp"
            android:textColor="@color/text_hint" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <include layout="@layout/bottom_navigation" />
</LinearLayout>
