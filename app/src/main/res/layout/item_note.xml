<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/note_chapter" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="12dp" android:paddingBottom="14dp" android:textSize="14sp"
        android:fontFamily="sans-serif-medium" android:textColor="@color/text_secondary" />
    <LinearLayout android:id="@+id/note_card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="@drawable/note_card_background"
        android:elevation="1dp">
        <TextView android:id="@+id/note_book" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" android:visibility="gone" android:textSize="13sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/note_kind" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="11sp" android:textColor="@color/primary" />
            <TextView android:id="@+id/note_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/text_hint" />
            <ImageButton android:id="@+id/note_favorite" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="4dp" android:layout_marginEnd="-10dp" android:padding="12dp"
                android:focusable="false" android:background="@drawable/text_button_background"
                android:contentDescription="@string/favorite_note" android:src="@drawable/ic_book_favorite_outline" />
        </LinearLayout>
        <TextView android:id="@+id/note_quote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:lineSpacingExtra="8dp" android:textSize="18sp"
            android:textColor="@color/text_primary" android:textIsSelectable="true" />
        <TextView android:id="@+id/note_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/secondary_button_background"
            android:lineSpacingExtra="6dp" android:textSize="15sp" android:textColor="@color/text_primary"
            android:textIsSelectable="true" />
    </LinearLayout>
</LinearLayout>
