<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@color/surface">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/library_back" style="@style/TextAction" android:layout_width="48dp" android:layout_height="48dp"
            android:text="@string/back" android:textColor="@color/text_secondary" android:paddingStart="0dp" android:paddingEnd="8dp" />
        <TextView android:id="@+id/notes_page_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="@string/book_notes"
            android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_primary" />
        <Button android:id="@+id/library_refresh" style="@style/TextAction" android:layout_width="wrap_content" android:layout_height="48dp"
            android:text="@string/sync" android:textColor="@color/text_secondary" />
    </LinearLayout>
    <TextView android:id="@+id/notes_book_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/notes_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
    <TextView android:id="@+id/notes_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
    <LinearLayout android:id="@+id/note_tabs" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:orientation="horizontal">
        <Button android:id="@+id/all_notes_tab" style="@style/ReadingTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/book_notes" />
        <Button android:id="@+id/favorite_notes_tab" style="@style/ReadingTab" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/favorite_notes" />
    </LinearLayout>
    <EditText android:id="@+id/note_search" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="16dp" android:hint="@string/search_notes" android:singleLine="true"
        android:background="@drawable/search_background" android:paddingStart="16dp" android:paddingEnd="16dp"
        android:inputType="text" android:imeOptions="actionDone" android:importantForAutofill="no"
        android:visibility="gone" android:textSize="14sp" android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="16dp">
        <ListView android:id="@+id/note_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@android:color/transparent" android:dividerHeight="12dp" android:listSelector="@android:color/transparent"
            android:clipToPadding="false" android:paddingBottom="12dp" />
        <TextView android:id="@+id/library_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="24dp" android:text="@string/loading_library"
            android:textSize="16sp" android:textColor="@color/text_secondary" />
    </FrameLayout>
    <TextView android:id="@+id/library_sync_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:paddingBottom="4dp" android:textSize="12sp" android:textColor="@color/text_secondary" />
</LinearLayout>
</FrameLayout>
