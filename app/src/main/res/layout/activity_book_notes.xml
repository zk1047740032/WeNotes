<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp">
        <LinearLayout android:id="@+id/notes_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/library_back" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="-12dp" android:src="@drawable/ic_back" android:padding="12dp"
                android:background="@drawable/text_button_background" android:contentDescription="@string/back" />
            <TextView android:id="@+id/notes_page_title" style="@style/PageTitle" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/book_notes"
                android:textSize="22sp" />
            <Button android:id="@+id/library_refresh" style="@style/TextAction" android:layout_width="wrap_content"
                android:layout_height="48dp" android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="6dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/sync" />
        </LinearLayout>
        <TextView android:id="@+id/notes_book_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:lineSpacingExtra="4dp" />
        <TextView android:id="@+id/notes_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp" />
        <TextView android:id="@+id/notes_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp" />
        <LinearLayout android:id="@+id/note_tabs" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="16dp" android:orientation="horizontal">
            <Button android:id="@+id/all_notes_tab" style="@style/ReadingTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="@string/book_notes" />
            <Button android:id="@+id/favorite_notes_tab" style="@style/ReadingTab" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1" android:text="@string/favorite_notes" />
        </LinearLayout>
        <EditText android:id="@+id/note_search" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="16dp" android:hint="@string/search_notes" android:singleLine="true"
            android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp"
            android:background="@drawable/search_background" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:inputType="text" android:imeOptions="actionDone" android:importantForAutofill="no"
            android:visibility="gone" android:textSize="14sp" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="20dp">
            <ListView android:id="@+id/note_list" android:layout_width="match_parent" android:layout_height="match_parent"
                android:divider="@android:color/transparent" android:dividerHeight="16dp"
                android:listSelector="@android:color/transparent" android:clipToPadding="false"
                android:paddingTop="2dp" android:paddingBottom="20dp" android:scrollbars="none" />
            <TextView android:id="@+id/library_empty" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:padding="24dp" android:text="@string/loading_library"
                android:textSize="15sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp" />
        </FrameLayout>
        <TextView android:id="@+id/library_sync_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:paddingTop="10dp" android:paddingBottom="12dp" android:textSize="11sp"
            android:textColor="@color/text_hint" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <include android:id="@+id/notes_bottom_navigation" layout="@layout/bottom_navigation" android:visibility="gone" />
</LinearLayout>
